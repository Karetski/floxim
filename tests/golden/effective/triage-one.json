{
  "nodes": {
    "apply": {
      "config": {
        "env": {
          "ISSUE": "${{ inputs.issue.number }}",
          "LABEL": "${{ nodes.classify.output.label }}",
          "REPLY": "${{ nodes.classify.output.reply }}"
        },
        "run": "gh issue edit \"$ISSUE\" --add-label \"$LABEL\"\ngh issue comment \"$ISSUE\" --body \"$REPLY\"\n",
        "type": "shell"
      },
      "type": "shell"
    },
    "classify": {
      "config": {
        "harness": "claude",
        "model": "sonnet",
        "next": [
          {
            "to": "apply",
            "when": "nodes.classify.output.confidence >= 0.7"
          },
          {
            "to": "end"
          }
        ],
        "output_schema": "schemas/triage.json",
        "permissions": "read-only",
        "prompt": "Classify this issue and draft a first response.\n${{ inputs.issue }}\n",
        "timeout": "10m",
        "type": "agent"
      },
      "type": "agent"
    }
  },
  "start": "classify"
}
